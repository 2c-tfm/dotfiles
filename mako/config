font=Share Tech Mono 10
background-color=#000000f2
text-color=#cdd6f4
border-color=#cdd6f4
border-size=1
border-radius=0
padding=10
margin=12
width=360
height=120
outer-margin=0
anchor=top-right
layer=overlay
default-timeout=5000
ignore-timeout=0
icons=1
max-icon-size=32
icon-path=/usr/share/icons/hicolor:/usr/share/icons
progress-color=#ff0055
markup=1
format=<b>%s</b>\n%b

[urgency=low]
border-color=#6f6570
default-timeout=3000

[urgency=normal]
border-color=#cdd6f4

[urgency=critical]
border-color=#ff0055
text-color=#ff5274
default-timeout=0
